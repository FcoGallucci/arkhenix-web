{
  // Configuración para Cloudflare Workers (se usa con «npx wrangler deploy»).
  "name": "arkhenix-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "vars": {
    "CONTACT_TO": "contacto@arkhenix.com"
  },
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "fae1cdfc0d7049cd979a6d76ca98ff38" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "arkhenix-media" }
  ],
  "observability": { "enabled": true }
}
